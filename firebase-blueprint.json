{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer record with GPS coordinates and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "phoneNormalized": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "photoUrl": { "type": "string", "maxLength": 2000000 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "firstName", "lastName", "fullName", "phone", "address", "isDeleted"]
    },
    "User": {
      "title": "User",
      "description": "System user account with role-based permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "loginId": { "type": "string", "maxLength": 64 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["ADMIN", "USER", "DRIVER"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": { "type": "object" },
        "lastLogin": { "type": "string" },
        "lastActivity": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "loginId", "name", "role", "status"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Delivery or field driver account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "loginId": { "type": "string", "maxLength": 64 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "loginId", "name", "phone", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail log tracking all mutations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 20 },
        "action": { "type": "string", "maxLength": 50 },
        "entityType": { "type": "string", "maxLength": 50 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "role", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer directory documents with GPS coordinates"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered system users and roles"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Driver credentials and profiles"
    },
    "/logs/{logId}": {
      "schema": "AuditLog",
      "description": "System-wide activity and audit records"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Connection test collection"
    }
  }
}
